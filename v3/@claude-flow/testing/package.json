{
  "name": "@claude-flow/testing",
  "version": "3.0.0",
  "type": "module",
  "description": "Testing module - TDD London School framework, test utilities, fixtures, and mock services for V3 Claude-Flow",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/@claude-flow/testing"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "import": "./dist/helpers/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "import": "./dist/setup.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "testing",
    "vitest",
    "tdd",
    "london-school",
    "mocks",
    "test-fixtures",
    "test-utilities",
    "ai-agents",
    "claude-flow",
    "ruflo",
    "typescript"
  ],
  "peerDependencies": {
    "@claude-flow/memory": "^3.0.0",
    "@claude-flow/shared": "^3.0.0",
    "@claude-flow/swarm": "^3.0.0",
    "vitest": ">=4.0.16"
  },
  "devDependencies": {
    "@claude-flow/memory": "^3.0.0",
    "@claude-flow/shared": "^3.0.0",
    "@claude-flow/swarm": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
