{
  "name": "@claude-flow/plugin-agent-federation",
  "version": "1.0.7",
  "description": "Cross-installation agent federation with zero-trust security, PII-gated data flow, and compliance-grade audit trails.",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/@claude-flow/plugin-agent-federation"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ruflo-federation": "dist/bin.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "benchmark:canonicalization": "npm run build && node scripts/benchmark-envelope-canonicalization.mjs",
    "benchmark:planner-descriptor": "npm run build && node scripts/benchmark-planner-descriptor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "agentic-flow": "^2.0.14 || ^3.0.0",
    "midstreamer": "^0.3.2"
  },
  "peerDependenciesMeta": {
    "agentic-flow": {
      "optional": true
    },
    "midstreamer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@claude-flow/shared": "^3.0.0",
    "@claude-flow/security": "^3.0.0",
    "@types/ws": "^8.18.1",
    "agentic-flow": "2.0.14",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "federation",
    "multi-agent",
    "ai-agents",
    "zero-trust",
    "pii",
    "security",
    "audit-trail",
    "compliance",
    "claude-flow-plugin",
    "claude-flow",
    "ruflo"
  ],
  "author": "Claude Flow Team",
  "license": "MIT"
}
