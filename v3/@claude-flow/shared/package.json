{
  "name": "@claude-flow/shared",
  "version": "3.0.8",
  "type": "module",
  "description": "Shared types, event bus, config schemas and validators, MCP transport helpers and resilience utilities used by the Ruflo (claude-flow) V3 packages.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./types": "./dist/types/index.js",
    "./core": "./dist/core/index.js",
    "./events": "./dist/events/index.js",
    "./hooks": "./dist/hooks/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./security": "./dist/security/index.js",
    "./resilience": "./dist/resilience/index.js",
    "./src/plugin-interface.js": "./dist/plugin-interface.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/__tests__",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "@types/ws": "^8.5.10",
    "cors": "^2.8.5",
    "express": "^4.22.3 || ^5.1.0",
    "helmet": "^7.2.0",
    "sql.js": "^1.10.3",
    "ws": "^8.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruflo",
    "claude-flow",
    "shared",
    "types",
    "event-bus",
    "config-validation",
    "zod",
    "mcp",
    "resilience",
    "typescript"
  ],
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/@claude-flow/shared"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  }
