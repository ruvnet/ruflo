# Copie ce fichier en .env.local et remplis les valeurs.

# --- Front (Next.js, aussi à définir dans les variables d'environnement Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Worker (uniquement sur la machine qui exécute les missions, JAMAIS sur Vercel) ---
SUPABASE_URL=https://xxxx.supabase.co
# Clé service_role : contourne la RLS. Ne la mets jamais dans une variable NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Dossiers de travail autorisés (nom affiché -> chemin absolu, dossier où `npx ruflo init` a été lancé).
# Le front ne peut choisir qu'un de ces noms : aucun chemin arbitraire n'est accepté.
MARIA_WORKSPACES={"demo":"/home/moi/projets/demo"}

# Mode de permission de Claude Code en headless : acceptEdits | dontAsk | plan | auto | bypassPermissions
# dontAsk = refuse tout ce qui n'est pas dans MARIA_ALLOWED_TOOLS.
MARIA_PERMISSION_MODE=acceptEdits
# Outils pré-autorisés (séparés par des virgules). Vide = règles par défaut du mode choisi.
# Tout ce qui n'est pas listé est refusé (personne ne peut approuver en headless) ; les refus
# s'affichent en fin de mission dans MarIA. Élargis selon ce que tes missions doivent faire.
MARIA_ALLOWED_TOOLS=Read,Glob,Grep,Edit,Write,Bash(npm install *),Bash(npm run *),Bash(npm test *),Bash(npm --prefix *),Bash(npx *),Bash(node *),Bash(ls *),Bash(git status *),Bash(git diff *),Bash(git log *)
# Modèle optionnel (alias ou nom complet). Vide = modèle par défaut de Claude Code.
MARIA_MODEL=
# Chemins ignorés dans la liste des fichiers modifiés (préfixes, séparés par des virgules).
MARIA_IGNORE_PATHS=.claude-flow/,.swarm/
# Binaire Claude Code et intervalle de polling (ms).
MARIA_CLAUDE_BIN=claude
MARIA_POLL_MS=2000
