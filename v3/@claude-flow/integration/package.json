{
  "name": "@claude-flow/integration",
  "version": "3.0.3",
  "type": "module",
  "description": "agentic-flow integration for Ruflo (claude-flow) V3: TokenOptimizer (ReasoningBank compact context, Agent Booster edits), worker pools and swarm adapters.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./token-optimizer": "./dist/token-optimizer.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc"
  },
  "keywords": [
    "ruflo",
    "claude-flow",
    "agentic-flow",
    "token-optimizer",
    "agent-booster",
    "reasoningbank",
    "anti-drift",
    "swarm",
    "multi-agent"
  ],
  "peerDependencies": {
    "agentic-flow": "^2.0.14 || ^3.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "agent-booster": "^0.2.2"
  },
  "claude-flow": {
    "optionalComponents": {
      "TokenOptimizer": {
        "description": "Token reduction via agentic-flow Agent Booster integration",
        "savings": "varies (depends on ReasoningBank cache hit rate and query patterns)",
        "features": [
          "ReasoningBank",
          "cache",
          "anti-drift-config"
        ],
        "requires": [
          "agentic-flow"
        ]
      }
    }
  },
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/@claude-flow/integration"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  }
}
