    "quantum-topology",
    "coherence-engine",
    "hallucination-detection",
    "mcp",
    "rag"
  ],
  "author": "rUv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/plugins/prime-radiant"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  },
  "homepage": "https://ruv.io",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@claude-flow/memory": "^3.0.0-0",
    "@claude-flow/security": "^3.0.0-0"
  },
