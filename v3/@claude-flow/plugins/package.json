{
  "name": "@claude-flow/plugins",
  "version": "3.0.3",
  "description": "Unified Plugin SDK for Claude Flow V3 - Worker, Hook, and Provider Integration",
  "homepage": "https://ruv.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruflo.git",
    "directory": "v3/@claude-flow/plugins"
  },
  "bugs": {
    "url": "https://github.com/ruvnet/ruflo/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./workers": {
      "types": "./dist/workers/index.d.ts",
      "import": "./dist/workers/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "events": "^3.3.0"
  },
  "optionalDependencies": {
    "@ruvnet/sublinear-core": "^1.0.1"
  },
  "peerDependencies": {
    "@claude-flow/hooks": "^3.0.0",
    "@claude-flow/memory": "^3.0.0",
    "@ruvector/learning-wasm": "^0.1.0",
    "@ruvector/wasm": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@claude-flow/hooks": {
      "optional": true
    },
    "@claude-flow/memory": {
      "optional": true
    },
    "@ruvector/wasm": {
      "optional": true
    },
    "@ruvector/learning-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "plugins",
    "plugin-sdk",
    "sdk",
    "hooks",
    "workers",
    "llm-providers",
    "ai-agents",
    "agentdb",
    "ruvector",
    "vector-search",
    "claude-flow",
    "ruflo"
  ],
  "author": "Claude Flow Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
